{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/session-start-superpowers.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"$HOME/.claude/hooks/guard-main-commit.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
